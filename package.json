{
  "name": "zenty",
  "version": "1.1.0",
  "description": "Type-safe CRUD stores for Zustand in one line",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zentylib/zenty.git"
  },
  "bugs": {
    "url": "https://github.com/zentylib/zenty/issues"
  },
  "homepage": "https://zentylib.com",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "build": "tsup src/index.ts --dts --format esm,cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "zustand",
    "state",
    "store",
    "entity",
    "crud",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": "Milaim Ajdari",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^29.0.0",
    "react": "^18.0.0",
    "ts-jest": "^29.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.61.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": "^4.4.0 || ^5.0.0"
  }
}
