{
  "name": "zenty-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Demo app that exercises every zenty feature, installed from the packed tarball like a real consumer.",
  "scripts": {
    "pack-lib": "node scripts/pack-lib.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:matrix": "bash scripts/matrix.sh"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zenty": "file:.lib/zenty.tgz",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "~5.9.3",
    "vite": "8.2.6"
  }
}
